{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QuantizationConfig",
    "description": "Schema for W2A16 quantization configuration",
    "type": "object",
    "properties": {
        "algorithm": {
            "type": "string",
            "enum": [
                "awq",
                "gptq",
                "smoothquant"
            ],
            "description": "Quantization algorithm"
        },
        "bits": {
            "type": "integer",
            "minimum": 2,
            "maximum": 8,
            "description": "Number of bits for weight quantization"
        },
        "group_size": {
            "type": "integer",
            "enum": [
                64,
                128,
                256
            ],
            "description": "Group size for per-group quantization"
        },
        "symmetric": {
            "type": "boolean",
            "description": "Whether to use symmetric quantization"
        },
        "packed_layout": {
            "type": "string",
            "enum": [
                "4x2bit_per_byte",
                "2x4bit_per_byte",
                "1x8bit_per_byte"
            ],
            "description": "Weight packing layout"
        },
        "preserve_dtype": {
            "type": "string",
            "enum": [
                "float16",
                "bfloat16",
                "float32"
            ],
            "description": "Data type for activations and scales"
        },
        "version": {
            "type": "string",
            "description": "Configuration version"
        }
    },
    "required": [
        "algorithm",
        "bits",
        "group_size",
        "symmetric"
    ],
    "additionalProperties": false,
    "examples": [
        {
            "algorithm": "awq",
            "bits": 2,
            "group_size": 128,
            "symmetric": true,
            "packed_layout": "4x2bit_per_byte",
            "preserve_dtype": "float16",
            "version": "1.0"
        },
        {
            "algorithm": "awq",
            "bits": 4,
            "group_size": 128,
            "symmetric": true,
            "packed_layout": "2x4bit_per_byte",
            "preserve_dtype": "float16",
            "version": "1.0"
        }
    ]
}